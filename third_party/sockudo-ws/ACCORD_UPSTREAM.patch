+/// Weak entries prevent negotiated configurations from retaining compressor
+/// memory after their last connection closes. Every live connection with the
+/// same exact agreement and role receives the same pool.
+fn configured_shared_pool(config: &DeflateConfig, is_server: bool) -> Arc<SharedCompressorPool> {
+    type PoolRegistry = Mutex<HashMap<(DeflateConfig, bool), Weak<SharedCompressorPool>>>;
+    static POOLS: OnceLock<PoolRegistry> = OnceLock::new();
+    let mut pools = POOLS.get_or_init(|| Mutex::new(HashMap::new())).lock();
+    let key = (config.clone(), is_server);
+    if let Some(pool) = pools.get(&key).and_then(Weak::upgrade) {
+        return pool;
+    }
+    pools.retain(|_, pool| pool.strong_count() != 0);
+    let pool = Arc::new(SharedCompressorPool::for_role(config.clone(), is_server));
+    pools.insert(key, Arc::downgrade(&pool));
+    pool
+}
