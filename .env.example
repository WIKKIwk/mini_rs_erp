# Mini RS ERP example configuration.
# Copy to .env for local or deployment use and replace placeholders.
# Never commit real database, Firebase, or AI credentials.

MOBILE_API_ADDR=:8081
RUST_LOG=info
MOBILE_API_LOCAL_STORE_ALLOW_JSON_FALLBACK=0
# Worker tabs: false = assigned apparatus + own completed history; true = all apparatus.
# Change this value and restart the backend. Execution permissions stay assignment-based.
MOBILE_API_WORKER_SHOW_ALL_APPARATUS_TABS=false
MOBILE_APP_RELEASE_DIR=data/mobile_releases

# Account credentials are stored as Argon2id hashes in PostgreSQL.
# Bootstrap/import with mini_rs_auth_migrate; do not add passwords here.

MINI_ERP_DATABASE_URL=postgres://mini_rs_erp:secret@127.0.0.1:5432/mini_rs_erp
MINI_ERP_HTTP_TIMEOUT_SECONDS=15
# HTTP bootstrap JSON favors size; WS live deltas use their separate level below.
MINI_ERP_HTTP_GZIP_LEVEL=8
MINI_ERP_DEFAULT_TARGET_WAREHOUSE=
MINI_ERP_DEFAULT_UOM=Kg

# System Doctor: repeated observations and separate recovery thresholds.
# Starts with the backend; settings take effect after restart.
MINI_ERP_DOCTOR_FAILURE_SAMPLES=3
MINI_ERP_DOCTOR_RECOVERY_SAMPLES=2
MINI_ERP_DOCTOR_MEMORY_CRITICAL_PERCENT=90
MINI_ERP_DOCTOR_MEMORY_RECOVERY_PERCENT=80
MINI_ERP_DOCTOR_DISK_CRITICAL_AVAILABLE_MB=1024
MINI_ERP_DOCTOR_DISK_RECOVERY_AVAILABLE_MB=1536
# Filesystem to observe (defaults to the backend working directory).
# MINI_ERP_DISK_MONITOR_PATH=/path/to/backend/data

# Internet recovery: try visible open Wi-Fi only after confirmed Internet loss.
# OS Wi-Fi permissions are required. Linux needs NetworkManager/nmcli;
# macOS needs the built CoreWLAN helper and Location Services authorization.
MINI_ERP_DOCTOR_WIFI_ENABLED=true
# MINI_ERP_DOCTOR_WIFI_INTERFACE=wlan0
MINI_ERP_DOCTOR_WIFI_CHECK_INTERVAL_SECONDS=15
MINI_ERP_DOCTOR_WIFI_FAILURE_SAMPLES=3
MINI_ERP_DOCTOR_WIFI_SETTLE_DELAY_SECONDS=5
MINI_ERP_DOCTOR_WIFI_RETRY_DELAY_SECONDS=5
MINI_ERP_DOCTOR_WIFI_NETWORK_COOLDOWN_SECONDS=300
MINI_ERP_DOCTOR_WIFI_ROUND_COOLDOWN_SECONDS=60
MINI_ERP_DOCTOR_WIFI_MAX_NETWORKS_PER_ROUND=5
MINI_ERP_DOCTOR_WIFI_PROBE_URLS=https://www.gstatic.com/generate_204,https://cp.cloudflare.com/generate_204
# MINI_ERP_DOCTOR_WIFI_MAC_HELPER=/absolute/path/to/doctor_wifi

# Domain health and Cloudflare Tunnel reconnection. up_domain.sh sets these
# automatically for the selected hostname and its managed runtime state.
# MINI_ERP_DOCTOR_DOMAIN_URL=https://erp.example.com
# MINI_ERP_DOCTOR_DOMAIN_LOCAL_URL=http://127.0.0.1:18081
# MINI_ERP_DOCTOR_DOMAIN_STATE_DIR=/absolute/path/to/garbage/domain/erp.example.com
# MINI_ERP_DOCTOR_DOMAIN_TUNNEL_NAME=mini-rs-erp-erp-example-com
MINI_ERP_DOCTOR_DOMAIN_CHECK_INTERVAL_SECONDS=30
MINI_ERP_DOCTOR_DOMAIN_FAILURE_SAMPLES=3
MINI_ERP_DOCTOR_DOMAIN_RECOVERY_SAMPLES=2
MINI_ERP_DOCTOR_DOMAIN_RESTART_COOLDOWN_SECONDS=60

# WebSocket transport: pinned Sockudo with negotiated RFC 7692 compression.
# Restart after changes. Existing clients without compression remain supported.
MINI_ERP_WS_COMPRESSION=dedicated
MINI_ERP_WS_COMPRESSION_LEVEL=3
MINI_ERP_WS_COMPRESSION_THRESHOLD=128
MINI_ERP_WS_WINDOW_BITS=15
MINI_ERP_WS_CONTEXT_TAKEOVER=true
MINI_ERP_WS_MAX_MESSAGE_BYTES=67108864
MINI_ERP_WS_MAX_FRAME_BYTES=16777216
MINI_ERP_WS_MAX_BACKPRESSURE_BYTES=67108864
MINI_ERP_WS_PING_SECONDS=25
MINI_ERP_WS_PONG_SECONDS=20
MINI_ERP_WS_IDLE_SECONDS=120

MOBILE_API_SESSION_STORE_PATH=data/mobile_sessions.json
MOBILE_API_SESSION_STORE_BACKEND=lmdb
MOBILE_API_SESSION_LMDB_PATH=data/mobile_sessions.lmdb
MOBILE_API_SESSION_LMDB_MAP_SIZE_MB=64
MOBILE_API_PROFILE_STORE_PATH=data/mobile_profile_prefs.json
MOBILE_API_PROFILE_STORE_BACKEND=lmdb
MOBILE_API_PROFILE_LMDB_PATH=data/mobile_profile_prefs.lmdb
MOBILE_API_PROFILE_LMDB_MAP_SIZE_MB=64
MOBILE_API_PUSH_TOKEN_STORE_PATH=data/mobile_push_tokens.json
MOBILE_API_PUSH_TOKEN_STORE_BACKEND=lmdb
MOBILE_API_PUSH_TOKEN_LMDB_PATH=data/mobile_push_tokens.lmdb
MOBILE_API_PUSH_TOKEN_LMDB_MAP_SIZE_MB=64
MOBILE_API_ADMIN_SUPPLIER_STORE_PATH=data/mobile_admin_suppliers.json
MOBILE_API_ADMIN_SUPPLIER_STORE_BACKEND=lmdb
MOBILE_API_ADMIN_SUPPLIER_LMDB_PATH=data/mobile_admin_suppliers.lmdb
MOBILE_API_ADMIN_SUPPLIER_LMDB_MAP_SIZE_MB=64
MOBILE_API_SESSION_TTL_HOURS=720

MOBILE_DEV_SUPPLIER_PREFIX=10
MOBILE_DEV_WERKA_PREFIX=20
MOBILE_DEV_WERKA_NAME=Werka

# Telegram bot + userbot (MTProto via ferogram).
# API_ID/HASH: https://my.telegram.org dan olinadi.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# MTProto sessiyalarni shifrlaydigan kalit (ixtiyoriy).
# Bo'sh qoldirilsa server birinchi startda o'zi random yaratib data papkada
# mobile_telegram.key faylida saqlaydi — hech qanday manual qadam shart emas.
# Faqat maxsus talab bo'lsa qo'lda bering (masalan bir nechta nusxa bitta
# kalitni bo'lishsa). Qiymat o'zgartirilsa eski sessiyalar qayta login talab qiladi.
TELEGRAM_USER_SESSION_KEY=
# Telegram holat fayli (bot token + shifrlangan sessiyalar). Default: data/mobile_telegram.json
MOBILE_API_TELEGRAM_STORE_PATH=data/mobile_telegram.json

# Optional integrations.
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-adminsdk.jsonGEMINI_API_KEY=
GEMINI_VISION_MODEL=
MOBILE_PROFILE_AVATAR_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MOBILE_PROFILE_AVATAR_R2_BUCKET=accord-profile-avatars
MOBILE_PROFILE_AVATAR_R2_ACCESS_KEY_ID=
MOBILE_PROFILE_AVATAR_R2_SECRET_ACCESS_KEY=
MOBILE_PROFILE_AVATAR_R2_REGION=auto
MOBILE_PROFILE_AVATAR_PUBLIC_BASE_URL=https://<public-avatar-host>

# Pingora gateway.
MINI_RS_GATEWAY_ADDR=127.0.0.1:18080
MINI_RS_GATEWAY_UPSTREAM=127.0.0.1:18081
MINI_RS_GATEWAY_UPSTREAM_HOST=127.0.0.1
MINI_RS_GATEWAY_HEALTH_PATH=/healthz
MINI_RS_GATEWAY_CONNECT_TIMEOUT_MS=1000
MINI_RS_GATEWAY_UPSTREAM_TIMEOUT_MS=30000
MINI_RS_GATEWAY_TLS_CERT_PATH=
MINI_RS_GATEWAY_TLS_KEY_PATH=
MINI_RS_GATEWAY_METRICS_ADDR=127.0.0.1:19091

# Optional response/stream encoder; sonic_rs requires --features sonic-json.
# Restart to change. serde_json is the default and rollback setting.
MINI_ERP_JSON_ENCODER=serde_json
# Legacy research switches remain supported. Omit the legacy encoder when using
# MINI_ERP_JSON_ENCODER (conflicting values fail startup). Sonic request decoding
# requires sonic-json-research and remains experimental; keep it off in production.
# MINI_ERP_RESEARCH_JSON_ENCODER=serde_json
# MINI_ERP_RESEARCH_JSON_DECODER=serde_json
